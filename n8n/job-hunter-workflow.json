        "jsCode": "const jobs = $('Filter Already Existing in Database').all();\n\nreturn $input.all().map((item, index) => {\n  const job = jobs[index].json;\n  const verdict = item.json;\n  return {\n    json: {\n      ...job,\n      ...verdict\n    }\n  };\n});"
